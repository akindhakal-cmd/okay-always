    b.innerHTML = `<span class="q"></span><span class="who"></span>`;
    b.querySelector(".q").textContent = Q.q; b.querySelector(".who").textContent = "— " + Q.who;
    b.style.opacity = "0";
    stage.appendChild(b);
    const bw = b.offsetWidth, bh = b.offsetHeight, SW = stage.clientWidth, SH = stage.clientHeight;
    const cx0 = cv.offsetLeft + cv.clientWidth / 2, cy0 = cv.offsetTop + cv.clientHeight * .42;
    const ang = Math.atan2(sy - cy0, sx - cx0) + rand(-.7, .7);
    const dist = rand(110, 210);
    let tx = sx + Math.cos(ang) * dist, ty = sy + Math.sin(ang) * dist - 30;
    tx = Math.min(SW - bw / 2 - 6, Math.max(bw / 2 + 6, tx));
    ty = Math.min(SH - bh / 2 - 6, Math.max(bh / 2 + 6, ty));
    const rot = rand(-6, 6);
    const x0 = sx - bw / 2, y0 = sy - bh / 2, x1 = tx - bw / 2, y1 = ty - bh / 2;
    b.style.opacity = "";
    b.animate([
      { transform: `translate(${x0}px,${y0}px) scale(.1) rotate(${rot * 3}deg)`, opacity: 0 },
      { transform: `translate(${x1}px,${y1}px) scale(1.06) rotate(${rot}deg)`, opacity: 1, offset: .12 },
      { transform: `translate(${x1}px,${y1}px) scale(1) rotate(${rot}deg)`, opacity: 1, offset: .16 },
      { transform: `translate(${x1}px,${y1 - 14}px) scale(1) rotate(${rot}deg)`, opacity: 1, offset: .88 },
      { transform: `translate(${x1}px,${y1 - 30}px) scale(.85) rotate(${rot}deg)`, opacity: 0 }
    ], { duration: 6500, easing: "cubic-bezier(.3,.7,.3,1)", fill: "both" }).onfinish = () => b.remove();
  }
  function hit(e) {
    const r = cv.getBoundingClientRect(), x = (e.clientX - r.left) * dpr, y = (e.clientY - r.top) * dpr;
    let best = -1, bd = Infinity;
    FLOWERS.forEach((f, i) => { const d = Math.hypot(f.px - x, f.py - y); if (d < f.Rp * 1.05 && d < bd) { bd = d; best = i; } });
    return best;
  }
  cv.addEventListener("click", e => { const i = hit(e); if (i >= 0) { clearInterval(quoteTimer); popQuote(i); quoteTimer = setInterval(() => popQuote(), 2800); } });
  cv.addEventListener("pointermove", e => { cv.style.cursor = hit(e) >= 0 ? "pointer" : "default"; });
  addEventListener("resize", () => { if (raf) resize(); });

  return {
    start() {
      cancelAnimationFrame(raf); t0 = 0;
      FLOWERS.forEach(f => { if (!f.kind.startsWith("bud")) f.open = -1; });
      requestAnimationFrame(() => { resize(); raf = requestAnimationFrame(frame); });
      clearInterval(quoteTimer); clearTimeout(startTimer);
      startTimer = setTimeout(() => { if (raf) { popQuote(); quoteTimer = setInterval(() => popQuote(), 2800); } }, 2600);
    },
    stop() { cancelAnimationFrame(raf); raf = 0; clearInterval(quoteTimer); clearTimeout(startTimer); stage.querySelectorAll(".qb,.poof").forEach(n => n.remove()); },
    popQuote
  };
})();

/* =====================================================================
   GIFT 2 · RECORD PLAYER
   ===================================================================== */
const audio = $("#song");
audio.src = CONFIG.songFile;
let playing = false, noteTimer = 0;
const fmt = s => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
audio.addEventListener("loadedmetadata", () => { if (isFinite(audio.duration)) $("#tEnd").textContent = fmt(audio.duration); });
audio.addEventListener("ended", () => { stopMusic(); audio.currentTime = 0; $("#tFill").style.width = "0%"; $("#tNow").textContent = "0:00"; });
function tick() {
  if (!playing) return;
  const dur = isFinite(audio.duration) && audio.duration ? audio.duration : CONFIG.songLength;
  const p = Math.min(1, audio.currentTime / dur);
  $("#tNow").textContent = fmt(audio.currentTime);
  $("#tFill").style.width = (p * 100) + "%";
  $("#arm").style.transform = `rotate(${24 + p * 14}deg)`;
  requestAnimationFrame(tick);
}
function startMusic() {
  playing = true;
  $("#tt").classList.add("playing");
  $("#ttIcon").innerHTML = '<path d="M7 5h4v14H7zM13 5h4v14h-4z"/>';
  $("#ttBtn").setAttribute("aria-label", "Pause");
  $("#arm").style.transform = "rotate(24deg)";
  $("#tkNote").textContent = "Now playing. Turn it up.";
  audio.play().then(() => requestAnimationFrame(tick)).catch(() => {
    $("#tkNote").innerHTML = 'The song file isn’t on this page yet. <a href="https://open.spotify.com/search/Breathe%20Malcolm%20Todd" target="_blank" rel="noopener">Play it on Spotify ↗</a>';
  });
  if (!REDUCE) { spawnNote(); noteTimer = setInterval(spawnNote, 260); }
}
function stopMusic() {
  if (!playing) return;
  playing = false; audio.pause();
  $("#tt").classList.remove("playing");
  $("#ttIcon").innerHTML = '<path d="M8 5v14l11-7z"/>';
  $("#ttBtn").setAttribute("aria-label", "Play");
  $("#arm").style.transform = "rotate(0deg)";
  clearInterval(noteTimer);
}
const toggle = () => playing ? stopMusic() : startMusic();
$("#ttBtn").addEventListener("click", toggle);
$("#platter").addEventListener("click", toggle);
$("#platter").addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); } });
function spawnNote() {
  const layer = $("#mnotes"), n = document.createElement("span");
  n.className = "mnote"; n.textContent = pick(["♪", "♫", "♩", "♬"]);
  n.style.fontSize = rand(18, 40) + "px"; n.style.color = pick(["#ff6f9c", "#7fc2f0", "#2b3566", "#ff8fb1"]);
  let startY = 0, x;
  if (Math.random() < .5) { const r = $("#platter").getBoundingClientRect(); x = r.left + r.width * rand(.15, .85); startY = -(innerHeight - (r.top + r.height * .5)); }
  else x = rand(0, innerWidth);
  n.style.left = x + "px"; layer.appendChild(n);
  const drift = rand(-160, 160), spin = rand(-40, 40);
  n.animate([
    { transform: `translate(0,${startY}px) rotate(0) scale(.5)`, opacity: 0 },
    { opacity: 1, offset: .12 },
    { transform: `translate(${drift * .5}px,${startY - innerHeight * .45}px) rotate(${spin / 2}deg) scale(1)`, offset: .5 },
    { transform: `translate(${drift}px,${startY - innerHeight - 90}px) rotate(${spin}deg) scale(.9)`, opacity: 0 }
  ], { duration: rand(4200, 7400), easing: "cubic-bezier(.25,.6,.4,1)" }).onfinish = () => n.remove();
}

/* =====================================================================
   GIFT 3 · LET'S BAKE
   ===================================================================== */
const ICONS = {
  flour: `<svg viewBox="0 0 64 64"><path d="M16 18 Q32 10 48 18 L52 56 Q32 62 12 56 Z" fill="#fff6ea" stroke="#2b3566" stroke-width="3" stroke-linejoin="round"/><path d="M20 18 q12 6 24 0" fill="none" stroke="#2b3566" stroke-width="3"/><rect x="18" y="32" width="28" height="12" rx="3" fill="#ffb7cd" stroke="#2b3566" stroke-width="2"/><text x="32" y="41" text-anchor="middle" font-size="7" font-weight="900" font-family="Nunito,sans-serif" fill="#2b3566">FLOUR</text></svg>`,
  sugar: `<svg viewBox="0 0 64 64"><rect x="14" y="18" width="36" height="38" rx="9" fill="#e3f2fd" stroke="#2b3566" stroke-width="3"/><rect x="16" y="9" width="32" height="11" rx="4" fill="#ff8fb1" stroke="#2b3566" stroke-width="3"/><g fill="#fff" stroke="#2b3566" stroke-width="2"><rect x="20" y="38" width="10" height="10" rx="2"/><rect x="33" y="40" width="10" height="10" rx="2"/><rect x="26" y="28" width="10" height="10" rx="2"/></g></svg>`,
  butter: `<svg viewBox="0 0 64 64"><rect x="6" y="34" width="52" height="20" rx="5" fill="#9fd0f3" stroke="#2b3566" stroke-width="3"/><path d="M14 22 L46 22 L52 34 L52 44 L14 44 Z" fill="#ffe08a" stroke="#2b3566" stroke-width="3" stroke-linejoin="round"/><path d="M46 22 L52 34 L18 34 L14 22" fill="#fff0b8" stroke="#2b3566" stroke-width="3" stroke-linejoin="round"/></svg>`,
  eggs: `<svg viewBox="0 0 64 64"><ellipse cx="24" cy="36" rx="12" ry="16" fill="#fff8ee" stroke="#2b3566" stroke-width="3"/><ellipse cx="42" cy="40" rx="11" ry="14" fill="#ffe9d6" stroke="#2b3566" stroke-width="3"/><path d="M19 28 q3 -5 7 -6" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg>`,
  sprinkles: `<svg viewBox="0 0 64 64"><rect x="14" y="18" width="36" height="38" rx="9" fill="#fff" stroke="#2b3566" stroke-width="3"/><rect x="16" y="9" width="32" height="11" rx="4" fill="#7fc2f0" stroke="#2b3566" stroke-width="3"/><g stroke-width="4" stroke-linecap="round"><path d="M20 30 l5 3" stroke="#ff6f9c"/><path d="M32 28 l5 -2" stroke="#ffe08a"/><path d="M40 36 l4 4" stroke="#7fc2f0"/><path d="M22 44 l5 -2" stroke="#c9b6f2"/><path d="M32 40 l2 5" stroke="#ff6f9c"/><path d="M38 48 l5 1" stroke="#7fc2f0"/></g></svg>`,
  stars: `<svg viewBox="0 0 64 64"><path d="M20 20 h24 l4 8 v24 q0 6 -6 6 h-20 q-6 0 -6 -6 v-24 z" fill="#2b3566" stroke="#2b3566" stroke-width="3" stroke-linejoin="round"/><rect x="22" y="10" width="20" height="10" rx="3" fill="#ffb7cd" stroke="#2b3566" stroke-width="3"/><g fill="#ffe08a"><path d="M28 32 l2 4 4 1 -3 3 1 4 -4 -2 -4 2 1 -4 -3 -3 4 -1z"/><circle cx="40" cy="44" r="2"/><circle cx="24" cy="48" r="1.6"/><circle cx="40" cy="30" r="1.4"/></g></svg>`
};
const added = [];
let bakeStage = "add";
function buildShelf() {
  $("#shelf").innerHTML = CONFIG.ingredients.map(i => `<button class="ing" data-ing="${i.id}">${ICONS[i.id] || ""}<span>${i.name}</span></button>`).join("");
}
function renderRecipe() {
  const ol = $("#recipeList");
  ol.innerHTML = "";
  if (!added.length) { ol.innerHTML = '<li class="empty">Nothing in yet…</li>'; return; }
  for (const id of added) { const li = document.createElement("li"); li.textContent = CONFIG.ingredients.find(i => i.id === id).line; ol.appendChild(li); }
  if (bakeStage === "done") { const li = document.createElement("li"); li.textContent = "Bake with love. Share with me."; ol.appendChild(li); }
}
function setBatter() {
  const lvl = added.length / CONFIG.ingredients.length;
  $("#batter").setAttribute("opacity", added.length ? 1 : 0);
  const top = $("#batterTop");
  top.setAttribute("rx", 60 + 62 * lvl); top.setAttribute("ry", 11 + 11 * lvl); top.setAttribute("cy", 118 - 6 * lvl);
  const sp = $("#sprinkleTop");
  if (added.includes("sprinkles") && !sp.childElementCount) {
    const cols = ["#ff6f9c", "#7fc2f0", "#ffe08a", "#c9b6f2"];
    for (let k = 0; k < 18; k++) {
      const x = 160 + rand(-90, 90) * Math.max(lvl, .5), y = 114 + rand(-10, 8) * Math.max(lvl, .5);
      const r = document.createElementNS("http://www.w3.org/2000/svg", "rect");
      r.setAttribute("x", x); r.setAttribute("y", y); r.setAttribute("width", 8); r.setAttribute("height", 3); r.setAttribute("rx", 1.5);
      r.setAttribute("fill", pick(cols)); r.setAttribute("transform", `rotate(${rand(0, 180)} ${x + 4} ${y + 1.5})`);
      sp.appendChild(r);
    }
  }
}
function puff(x, y, color) {
  for (let k = 0; k < 10; k++) {
    const d = document.createElement("span"); d.className = "confetti";
    d.style.cssText = `left:${x}px;top:${y}px;width:12px;height:12px;border-radius:50%;background:${color};border:1.5px solid rgba(43,53,102,.4)`;
    document.body.appendChild(d);
    const an = rand(-3, 0), dist = rand(30, 80);
    d.animate([{ transform: "translate(-50%,-50%) scale(1)", opacity: 1 }, { transform: `translate(calc(-50% + ${Math.cos(an) * dist}px), calc(-50% + ${Math.sin(an) * dist}px)) scale(.2)`, opacity: 0 }], { duration: 800, easing: "ease-out" }).onfinish = () => d.remove();
  }
}
$("#shelf").addEventListener("click", e => {
  const b = e.target.closest(".ing"); if (!b || b.classList.contains("used") || bakeStage !== "add") return;
  const id = b.dataset.ing; b.classList.add("used"); b.disabled = true;
  const from = b.querySelector("svg").getBoundingClientRect(), to = $("#bowlBox").getBoundingClientRect();
  const ghost = b.querySelector("svg").cloneNode(true);
  ghost.style.cssText = `position:fixed;z-index:7;left:${from.left}px;top:${from.top}px;width:${from.width}px;height:${from.height}px;pointer-events:none`;
  document.body.appendChild(ghost);
  const dx = to.left + to.width / 2 - from.left - from.width / 2, dy = to.top + to.height * .38 - from.top - from.height / 2;
  ghost.animate([
    { transform: "translate(0,0) rotate(0) scale(1)" },
    { transform: `translate(${dx * .5}px,${dy * .5 - 90}px) rotate(160deg) scale(1.1)`, offset: .5 },
    { transform: `translate(${dx}px,${dy}px) rotate(320deg) scale(.4)`, opacity: .2 }
  ], { duration: REDUCE ? 10 : 750, easing: "cubic-bezier(.4,.1,.5,1)" }).onfinish = () => {
    ghost.remove();
    puff(to.left + to.width / 2, to.top + to.height * .4, id === "flour" ? "#ffffff" : id === "sugar" ? "#e3f2fd" : id === "stars" ? "#ffe08a" : "#ffb7cd");
    added.push(id); setBatter(); renderRecipe();
    const n = CONFIG.ingredients.length;
    $("#benchMsg").textContent = added.length < n ? `${added.length} of ${n} in the bowl` : "Everything’s in. Time to mix!";
    if (added.length === n) { bakeStage = "mix"; $("#bakeBtn").disabled = false; }
  };
});
$("#bakeBtn").addEventListener("click", () => {
  const btn = $("#bakeBtn");
  if (bakeStage === "mix") {
    btn.disabled = true; $("#bowlBox").classList.add("mixing"); $("#benchMsg").textContent = "Whisk whisk whisk…";
    $("#swirlPath").setAttribute("opacity", 1);
    setTimeout(() => {
      $("#bowlBox").classList.remove("mixing"); $("#batterTop").setAttribute("fill", "#ffc7d8");
      bakeStage = "bake"; btn.textContent = "Bake it"; btn.disabled = false; $("#benchMsg").textContent = "Looking pink and perfect.";
    }, REDUCE ? 10 : 2000);
  } else if (bakeStage === "bake") {
    btn.disabled = true; $("#bowlSvg").style.visibility = "hidden"; $("#ovenMini").hidden = false;
    let s = 3; $("#ovenTime").textContent = `0:0${s}`; $("#benchMsg").textContent = "Smells amazing in here…";
    const iv = setInterval(() => {
      s--; $("#ovenTime").textContent = s > 0 ? `0:0${s}` : "DING!";
      if (s <= 0) {
        clearInterval(iv);
        setTimeout(() => {
          $("#ovenMini").hidden = true; $("#cakeOut").hidden = false; bakeStage = "done"; renderRecipe();
          const r = $("#bowlBox").getBoundingClientRect(); confetti(r.left + r.width / 2, r.top + r.height * .4);
          $("#benchMsg").textContent = CONFIG.cakeNote;
          btn.textContent = "Bake it again"; btn.disabled = false;
        }, 600);
      }
    }, REDUCE ? 10 : 900);
  } else if (bakeStage === "done") resetBake();
});
function confetti(x, y) {
  if (REDUCE) return;
  const cols = ["#ff6f9c", "#7fc2f0", "#ffe08a", "#c9b6f2", "#ffffff"];
  for (let k = 0; k < 70; k++) {
    const d = document.createElement("span"); d.className = "confetti";
    d.style.cssText = `left:${x}px;top:${y}px;background:${pick(cols)};border:1.5px solid #2b3566`;
    document.body.appendChild(d);
    const an = rand(-Math.PI, 0), v = rand(140, 380), dx = Math.cos(an) * v, dy = Math.sin(an) * v;
    d.animate([
      { transform: `translate(0,0) rotate(0)`, opacity: 1 },
      { transform: `translate(${dx}px,${dy}px) rotate(${rand(180, 540)}deg)`, opacity: 1, offset: .45 },
      { transform: `translate(${dx * 1.2}px,${dy + 420}px) rotate(${rand(540, 900)}deg)`, opacity: 0 }
    ], { duration: rand(1600, 2400), easing: "cubic-bezier(.2,.6,.4,1)" }).onfinish = () => d.remove();
  }
}
function resetBake() {
  added.length = 0; bakeStage = "add";
  $("#sprinkleTop").innerHTML = ""; $("#batterTop").setAttribute("fill", "#fff1d6"); $("#swirlPath").setAttribute("opacity", 0);
  $("#bowlSvg").style.visibility = ""; $("#cakeOut").hidden = true; $("#ovenMini").hidden = true;
  $("#bakeBtn").textContent = "Mix it"; $("#bakeBtn").disabled = true;
  $("#benchMsg").textContent = `0 of ${CONFIG.ingredients.length} in the bowl`;
  buildShelf(); setBatter(); renderRecipe();
}
buildShelf(); setBatter();

/* ---------------- a gift opened in its own tab ---------------- */
const startHash = location.hash.slice(1);
if (!EMBEDDED && GIFTS.some(g => g.id === startHash)) {
  SOLO = true; $("#lock").hidden = true;
  document.querySelectorAll("[data-close] span").forEach(s => s.textContent = "Close this gift");
  current = startHash; enter($("#g-" + startHash));
  if (startHash === "lilies") Lilies.start();
}
</script>

