<script>
/* =====================================================================
   ✏️  EDIT ME
   ===================================================================== */
const CONFIG = {
  // 🔑 SECRET CODE. Change these digits to whatever you want.
  passcode: "5559275555",

  // 🎵 The song file. Put the mp3 next to this page with exactly this name.
  songFile: "breathe.mp3",
  songLength: 176, // 2 min 56 sec

  // Lines that pop out of the lilies (The Fault in Our Stars)
  quotes: [
    { q: "Okay? Okay.", who: "Gus & Hazel" },
    { q: "Some infinities are bigger than other infinities.", who: "Hazel" },
    { q: "I fell in love the way you fall asleep: slowly, and then all at once.", who: "Hazel" },
    { q: "Come quickly, I am tasting the stars!", who: "Amsterdam dinner" },
    { q: "It’s a metaphor, see.", who: "Gus" },
    { q: "You gave me a forever within the numbered days.", who: "Hazel" },
    { q: "Maybe okay will be our always.", who: "Gus" },
    { q: "These lilies are a metaphor too. Probably.", who: "Me" },
    { q: "Hazel had Gus. You have me (and lilies).", who: "Me" }
  ],

  // The bake game: each ingredient and its line on the recipe card
  ingredients: [
    { id: "flour", name: "Flour", line: "2 cups of flour, for a solid base (like us)" },
    { id: "sugar", name: "Sugar", line: "A LOT of sugar. Still not as sweet as you" },
    { id: "butter", name: "Butter", line: "1 stick of butter, soft (like me when you laugh)" },
    { id: "eggs", name: "Eggs", line: "2 eggs, cracked. Unlike our secret code" },
    { id: "sprinkles", name: "Sprinkles", line: "Sprinkles: too many. No such thing" },
    { id: "stars", name: "Stars", line: "A pinch of stars. “Come quickly, I am tasting the stars!”" }
  ],
  cakeNote: "Fresh out of the oven, made with you in mind. Serves two, best eaten together. (Yes, that’s an invitation.)"
};
/* ===================================================================== */

const $ = (s, r = document) => r.querySelector(s);
const REDUCE = matchMedia("(prefers-reduced-motion: reduce)").matches;
const EMBEDDED = (() => { try { return window.self !== window.top; } catch (e) { return true; } })();
const rand = (a, b) => a + Math.random() * (b - a);
const pick = a => a[Math.floor(Math.random() * a.length)];

/* ---------------- sprinkles background ---------------- */
(function sprinkles() {
  const c = $("#sprinkles"), ctx = c.getContext("2d");
  const COLS = ["#ff8fb1", "#7fc2f0", "#ffffff", "#ffe08a", "#c9b6f2", "#ff6f9c"];
  let w, h, dpr, bits = [];
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2); w = innerWidth; h = innerHeight;
    c.width = w * dpr; c.height = h * dpr; c.style.width = w + "px"; c.style.height = h + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.round(w * h / 16000);
    bits = Array.from({ length: n }, () => ({ x: rand(0, w), y: rand(0, h), r: rand(0, 6.28), vr: rand(-.02, .02), vy: rand(.15, .5), vx: rand(-.15, .15), l: rand(8, 14), c: pick(COLS), heart: Math.random() < .08 }));
    if (REDUCE) draw();
  }
  function heart(x, y, s) { ctx.beginPath(); ctx.moveTo(x, y + s * .3); ctx.bezierCurveTo(x - s, y - s * .4, x - s * .4, y - s, x, y - s * .35); ctx.bezierCurveTo(x + s * .4, y - s, x + s, y - s * .4, x, y + s * .3); ctx.fill(); }
  function draw() {
    ctx.clearRect(0, 0, w, h);
    for (const b of bits) {
      if (!REDUCE) { b.y += b.vy; b.x += b.vx; b.r += b.vr; if (b.y > h + 20) { b.y = -20; b.x = rand(0, w); } }
      ctx.save(); ctx.translate(b.x, b.y); ctx.rotate(b.r); ctx.globalAlpha = .75;
      ctx.fillStyle = b.c;
      if (b.heart) heart(0, 0, 8);
      else { ctx.beginPath(); if (ctx.roundRect) ctx.roundRect(-b.l / 2, -2.2, b.l, 4.4, 2.2); else ctx.rect(-b.l / 2, -2.2, b.l, 4.4); ctx.fill(); if (b.c === "#ffffff") { ctx.strokeStyle = "rgba(43,53,102,.15)"; ctx.stroke(); } }
      ctx.restore();
    }
  }
  function loop() { draw(); requestAnimationFrame(loop); }
  addEventListener("resize", resize); resize();
  if (!REDUCE) requestAnimationFrame(loop);
})();

/* ---------------- view switching ---------------- */
function enter(el) {
  el.hidden = false; el.scrollTop = 0;
  if (REDUCE) return;
  el.classList.add("is-entering");
  const done = e => { if (e.target === el) { el.classList.remove("is-entering"); el.removeEventListener("animationend", done); } };
  el.addEventListener("animationend", done);
}
function leave(el, cls = "is-leaving", ms = 520) {
  return new Promise(res => {
    if (!el || el.hidden) return res();
    el.classList.add(cls);
    setTimeout(() => { el.hidden = true; el.classList.remove(cls); res(); }, REDUCE ? 10 : ms);
  });
}

/* ---------------- Stage 1: code ---------------- */
const CODE = String(CONFIG.passcode).replace(/\D/g, "");
const GROUPS = CODE.length === 10 ? [3, 4, 3] : [CODE.length];
let entry = "", unlocking = false;
function renderLCD(text) {
  const lcd = $("#lcd");
  lcd.classList.toggle("msg", !!text);
  if (text) { lcd.textContent = text; return; }
  let i = 0, html = "";
  for (const g of GROUPS) {
    html += '<span class="grp">';
    for (let k = 0; k < g; k++, i++) html += `<span class="d${i < entry.length ? " on" : ""}">${i < entry.length ? entry[i] : "–"}</span>`;
    html += "</span>";
  }
  lcd.innerHTML = html;
  lcd.setAttribute("aria-label", `${entry.length} of ${CODE.length} numbers entered`);
}
renderLCD();
function press(k) {
  if (unlocking) return;
  const btn = document.querySelector(`.key[data-k="${k}"]`);
  if (btn) { btn.classList.add("pressed"); setTimeout(() => btn.classList.remove("pressed"), 110); }
  $("#lockMsg").textContent = "";
  if (k === "del") entry = entry.slice(0, -1);
  else if (k === "ok") return check();
  else if (entry.length < CODE.length) entry += k;
  renderLCD();
}
function check() {
  const lcd = $("#lcd");
  if (entry === CODE) {
    unlocking = true;
    renderLCD("DING!");
    $("#lockMsg").textContent = "Ding! It’s ready.";
    setTimeout(() => $("#door").classList.add("open"), 300);
    setTimeout(async () => { await leave($("#lock"), "is-unlocking", 1050); enter($("#chamber")); }, 1300);
  } else {
    const short = entry.length < CODE.length;
    renderLCD(short ? "MORE" : "OOPS");
