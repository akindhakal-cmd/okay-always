<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Okay, Always</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=DM+Mono:wght@500&family=Nunito:wght@400;600;700;800;900&display=swap">
<style>
/* Layout: a pink gingham bakery table with sprinkles drifting over it; each screen is a full-viewport room that pops into the next. */
:root{
  --bg:#ffe3ed;
  --bg2:#ffd0e0;
  --cream:#fffaf4;
  --pink:#ff6f9c;
  --pink-soft:#ffb7cd;
  --blue:#7fc2f0;
  --blue-soft:#cfe9fb;
  --ink:#2b3566;
  --muted:#7b6f98;
  --butter:#ffe08a;

  --f-display:"Bagel Fat One","Arial Rounded MT Bold","Trebuchet MS",sans-serif;
  --f-body:"Nunito","Avenir Next","Segoe UI",system-ui,sans-serif;
  --f-mono:"DM Mono",ui-monospace,Menlo,Consolas,monospace;
  --pop:cubic-bezier(.34,1.56,.64,1);
  --ease:cubic-bezier(.2,.8,.2,1);
  color-scheme:light;
}
html,body{height:100%}
[hidden]{display:none!important}
body{
  margin:0;color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.5;overflow:hidden;
  background-color:var(--bg);
  background-image:
    linear-gradient(90deg,rgba(255,255,255,.42) 50%,transparent 50%),
    linear-gradient(rgba(255,255,255,.42) 50%,transparent 50%);
  background-size:56px 56px;
}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background:radial-gradient(45% 40% at 8% 92%,rgba(127,194,240,.35),transparent 70%),radial-gradient(40% 35% at 95% 6%,rgba(127,194,240,.28),transparent 70%)}
#sprinkles{position:fixed;inset:0;z-index:0;pointer-events:none}
button{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:14px}

.view{position:fixed;inset:0;z-index:2;overflow-y:auto;overflow-x:hidden;padding-inline:16px;
  padding-block:calc(env(safe-area-inset-top,0px) + 22px) calc(env(safe-area-inset-bottom,0px) + 40px)}
.is-entering{animation:popIn .8s var(--pop) both}
.is-leaving{animation:popOut .55s ease-in both;pointer-events:none}
.is-unlocking{animation:zoomThrough 1.1s cubic-bezier(.65,0,.35,1) both;pointer-events:none}
@keyframes popIn{from{opacity:0;transform:scale(.92) translateY(20px)}to{opacity:1;transform:none}}
@keyframes popOut{to{opacity:0;transform:scale(.95) translateY(10px)}}
@keyframes zoomThrough{0%{opacity:1;transform:none}100%{opacity:0;transform:scale(2.4);transform-origin:38% 55%}}
.title{font-family:var(--f-display);font-weight:400;color:var(--pink);letter-spacing:.01em;line-height:1.05;margin:0;text-wrap:balance;
  text-shadow:3px 3px 0 var(--blue),6px 6px 0 rgba(43,53,102,.12)}
.sub{margin:0;font-weight:700;color:var(--muted);font-size:clamp(1rem,2.3vw,1.2rem)}

/* ---------------- Stage 1: the microwave ---------------- */
#lock .wrap{width:min(860px,100%);margin-inline:auto;display:grid;justify-items:center;gap:22px;text-align:center;padding-top:clamp(0px,3vh,30px)}
#lock .title{font-size:clamp(2.2rem,6vw,3.6rem)}
.mw-area{position:relative;width:min(780px,100%);padding-top:26px}
.note{position:absolute;right:6%;top:0;z-index:3;background:#fff6a8;border:2px solid var(--ink);padding:10px 16px 12px;transform:rotate(5deg);
  font-weight:900;font-size:1.05rem;box-shadow:4px 4px 0 rgba(43,53,102,.25)}
.note::before{content:"";position:absolute;left:50%;top:-12px;width:20px;height:20px;margin-left:-10px;border-radius:50%;background:var(--pink);border:2px solid var(--ink)}
.mw{position:relative;display:grid;grid-template-columns:1.55fr 1fr;gap:18px;padding:20px;background:var(--blue-soft);
  border:3px solid var(--ink);border-radius:30px;box-shadow:10px 10px 0 var(--ink)}
.door-hold{position:relative;perspective:1200px}
.cavity{position:absolute;inset:0;border-radius:20px;border:3px solid var(--ink);
  background:radial-gradient(circle at 50% 55%,#fffdf0,#ffe7a8 45%,#ffc98a 80%)}
.door{position:relative;z-index:1;display:grid;grid-template-columns:1fr 26px;gap:14px;padding:16px;background:#e9f5fe;border:3px solid var(--ink);border-radius:20px;
  transform-origin:left center;transition:transform 1.1s var(--pop);backface-visibility:hidden}
.door.open{transform:rotateY(-108deg)}
.win{position:relative;aspect-ratio:1.45;border-radius:14px;border:3px solid var(--ink);overflow:hidden;
  background:radial-gradient(circle at 50% 70%,#fff6d6,#ffd98f 50%,#f7ad7f 100%)}
.win::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,.45) 38%,transparent 46%,transparent 58%,rgba(255,255,255,.25) 62%,transparent 68%)}
.win svg{position:absolute;left:50%;bottom:4%;width:56%;transform:translateX(-50%)}
.rise{transform-box:fill-box;transform-origin:50% 100%;animation:rise 2.4s ease-in-out infinite}
@keyframes rise{0%,100%{transform:scaleY(1)}50%{transform:scaleY(1.035)}}
.handle{border:3px solid var(--ink);border-radius:999px;background:linear-gradient(90deg,#fff,#c7d6e8)}
.panel{display:grid;gap:14px;align-content:start}
.lcd{background:var(--ink);color:#ffd1e0;border-radius:14px;padding:12px 10px;font-family:var(--f-mono);font-size:clamp(1.05rem,2.6vw,1.3rem);
  letter-spacing:.08em;display:flex;justify-content:center;gap:.55em;min-height:1.6em;box-shadow:inset 0 0 0 3px #3b4a85;white-space:nowrap;font-variant-numeric:tabular-nums}
.lcd .grp{display:flex;gap:.12em}
.lcd .d{width:.72em;text-align:center;opacity:.35}
.lcd .d.on{opacity:1;text-shadow:0 0 8px rgba(255,111,156,.8)}
.lcd.msg{letter-spacing:.3em;color:#fff}
.lcd.bad{animation:shake .45s}
@keyframes shake{20%,60%{transform:translateX(-7px)}40%,80%{transform:translateX(7px)}}
.keys{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.key{aspect-ratio:1.25;border-radius:14px;border:2.5px solid var(--ink);background:var(--cream);box-shadow:3px 3px 0 var(--ink);
  font-weight:900;font-size:1.25rem;cursor:pointer;display:grid;place-items:center;transition:transform .08s,box-shadow .08s;-webkit-tap-highlight-color:transparent}
.key:hover{background:#fff}
.key:active,.key.pressed{transform:translate(3px,3px);box-shadow:0 0 0 var(--ink)}
.key.k-del{background:var(--blue-soft)}
.key.k-ok{background:var(--pink);color:#fff}
.key svg{width:22px;height:22px}
.lock-msg{min-height:1.5em;margin:0;font-weight:800;color:var(--pink)}

/* ---------------- Stage 2: gifts ---------------- */
#chamber .wrap{width:min(1080px,100%);margin-inline:auto;display:grid;justify-items:center;gap:14px;text-align:center;padding-top:clamp(10px,5vh,56px)}
#chamber .title{font-size:clamp(2.8rem,8vw,5rem);animation:dropIn .9s .1s var(--pop) both}
#chamber .sub{animation:dropIn .9s .5s var(--pop) both}
@keyframes dropIn{from{opacity:0;transform:translateY(-26px)}to{opacity:1;transform:none}}
.returning .title,.returning .sub,.returning .gift,.returning .ch-quote{animation-delay:0s!important;animation-duration:.5s!important}
.gifts{display:flex;flex-wrap:wrap;justify-content:center;gap:clamp(4px,3vw,36px);margin-top:clamp(6px,2vh,20px)}
.ch-quote{margin:6px 0 0;font-weight:800;color:var(--ink);background:var(--cream);border:2.5px solid var(--ink);border-radius:999px;padding:8px 18px;box-shadow:4px 4px 0 var(--pink);animation:dropIn .9s 2.2s var(--pop) both}

.gift{
  --s:150px;--h:calc(var(--s)*.78);--L:calc(var(--s)*1.1);--lh:calc(var(--s)*.24);--rw:calc(var(--s)*.075);
  --paper:#ffc7d8;--paper2:#ff9fbd;--rib:#6fb8ec;--rib2:#4a9bd6;--pat:radial-gradient(circle,rgba(255,255,255,.75) 0 3px,transparent 3.5px) 0 0/22px 22px;
  position:relative;width:calc(var(--s)*1.6);padding:calc(var(--s)*.62) 0 6px;background:none;border:0;cursor:pointer;
  display:grid;justify-items:center;gap:calc(var(--s)*.26);animation:giftIn .9s var(--d,1.3s) var(--pop) both;-webkit-tap-highlight-color:transparent}
.gift.blue{--paper:#cfe9fb;--paper2:#8fc8f0;--rib:#ff6f9c;--rib2:#e24f80;--pat:repeating-linear-gradient(90deg,rgba(255,255,255,.55) 0 7px,transparent 7px 18px)}
.gift.cream{--paper:#fff6ea;--paper2:#ffe2cf;--rib:#ff6f9c;--rib2:#e24f80;--pat:linear-gradient(90deg,rgba(127,194,240,.28) 50%,transparent 50%) 0 0/20px 20px,linear-gradient(rgba(127,194,240,.28) 50%,transparent 50%) 0 0/20px 20px}
@keyframes giftIn{from{opacity:0;transform:translateY(40px) scale(.8)}to{opacity:1;transform:none}}
.gift .bob,.gift .lift,.gift .cube,.gift .shadow,.gift .burst,.gift .lid,.gift .bow,.gift .tag,.gift .tag span{display:block}
.gift .bob{animation:bob 3.6s var(--bd,0s) ease-in-out infinite}
@keyframes bob{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-9px) rotate(1deg)}}
.gift .lift{position:relative;perspective:900px;transition:transform .5s var(--pop)}
.gift:hover .lift,.gift:focus-visible .lift{transform:translateY(-16px) scale(1.07) rotate(-2deg)}
.gift .shadow{position:absolute;left:50%;bottom:calc(var(--s)*-.3);width:calc(var(--s)*1.35);height:calc(var(--s)*.22);transform:translateX(-50%);border-radius:50%;background:rgba(43,53,102,.16);transition:transform .5s;pointer-events:none}
.gift:hover .shadow{transform:translateX(-50%) scale(.85)}
.cube{position:relative;width:var(--s);height:var(--h);transform-style:preserve-3d;transform:rotateX(-18deg) rotateY(-34deg);transition:transform .9s var(--ease)}
.gift:hover .cube,.gift:focus-visible .cube{transform:rotateX(-21deg) rotateY(-18deg)}
.face,.lf{position:absolute;left:0;top:0;backface-visibility:hidden}
.face{width:var(--s);height:var(--h)}
.paper{background:
  linear-gradient(90deg,transparent calc(50% - var(--rw)),var(--rib) calc(50% - var(--rw)),var(--rib2) 50%,var(--rib) calc(50% + var(--rw)),transparent calc(50% + var(--rw))),
  var(--pat),linear-gradient(180deg,var(--paper),var(--paper2));box-shadow:inset 0 0 0 2.5px var(--ink)}
.f-front{transform:translateZ(calc(var(--s)/2))}
.f-back{transform:rotateY(180deg) translateZ(calc(var(--s)/2))}
.f-right{transform:rotateY(90deg) translateZ(calc(var(--s)/2))}
.f-left{transform:rotateY(-90deg) translateZ(calc(var(--s)/2))}
.f-right::after,.f-left::after,.f-back::after,.lf-right::after,.lf-left::after{content:"";position:absolute;inset:0;background:rgba(43,53,102,.18);box-shadow:inset 0 0 0 2.5px var(--ink)}
.f-inside{width:var(--s);height:var(--s);top:calc((var(--h) - var(--s))/2);transform:rotateX(90deg) translateZ(calc(var(--h)/2 - 1px));
  background:radial-gradient(circle,#fff 0,#fff3b0 25%,#ffb7cd 75%);box-shadow:inset 0 0 0 2.5px var(--ink)}
.lid{position:absolute;width:var(--L);height:var(--lh);left:calc((var(--s) - var(--L))/2);top:calc(var(--lh)*-.55);transform-style:preserve-3d;transition:transform 1s var(--pop)}
.lf{width:var(--L);height:var(--lh)}
.lf-front{transform:translateZ(calc(var(--L)/2))}
.lf-back{transform:rotateY(180deg) translateZ(calc(var(--L)/2))}
.lf-right{transform:rotateY(90deg) translateZ(calc(var(--L)/2))}
.lf-left{transform:rotateY(-90deg) translateZ(calc(var(--L)/2))}
.lid .lf-top{height:var(--L);top:calc((var(--lh) - var(--L))/2);transform:rotateX(90deg) translateZ(calc(var(--lh)/2));box-shadow:inset 0 0 0 2.5px var(--ink);
  background:
    linear-gradient(90deg,transparent calc(50% - var(--rw)),var(--rib) calc(50% - var(--rw)),var(--rib) calc(50% + var(--rw)),transparent calc(50% + var(--rw))),
    linear-gradient(0deg,transparent calc(50% - var(--rw)),var(--rib2) calc(50% - var(--rw)),var(--rib2) calc(50% + var(--rw)),transparent calc(50% + var(--rw))),
    var(--pat),var(--paper)}
.bow{position:absolute;width:calc(var(--s)*.78);left:calc((var(--L) - var(--s)*.78)/2);bottom:calc(100% - var(--s)*.05);pointer-events:none}
.bow.b2{transform:rotateY(90deg)}
.bow path,.bow ellipse{fill:var(--rib);stroke:var(--ink);stroke-width:3;stroke-linejoin:round}
.bow .shade{fill:var(--rib2)}
.burst{position:absolute;left:50%;top:0;width:calc(var(--s)*1.7);aspect-ratio:1;transform:translate(-50%,-50%) scale(.2);border-radius:50%;
  background:radial-gradient(closest-side,#fff,rgba(255,224,138,.8) 35%,rgba(255,183,205,.5) 60%,transparent);opacity:0;pointer-events:none}
.gift.opening .lid{transform:translate3d(calc(var(--s)*.12),calc(var(--s)*-.85),0) rotateZ(-18deg) rotateX(14deg)}
.gift.opening .burst{animation:burst 1s .15s ease-out forwards}
@keyframes burst{30%{opacity:1}100%{opacity:0;transform:translate(-50%,-70%) scale(1.5)}}
.gift.opened .lid{transform:translate3d(0,calc(var(--s)*-.1),0) rotateZ(-7deg)}
.gift .tag{display:grid;gap:4px;justify-items:center}
.gift .tag .t1{font-family:var(--f-display);font-size:1.5rem;color:var(--ink);line-height:1}
.gift .tag .t2{font-family:var(--f-mono);font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;background:var(--cream);border:2px solid var(--ink);border-radius:999px;padding:2px 10px;transition:background .3s}
.gift.opened .tag .t2{background:var(--pink-soft)}

/* ---------------- shared room bits ---------------- */
.back{position:fixed;z-index:8;left:16px;top:calc(env(safe-area-inset-top,0px) + 14px);display:inline-flex;align-items:center;gap:6px;
  padding:8px 16px 8px 10px;border-radius:999px;border:2.5px solid var(--ink);background:var(--cream);box-shadow:3px 3px 0 var(--ink);
  font-weight:800;font-size:.9rem;cursor:pointer;transition:transform .1s,box-shadow .1s}
.back:active{transform:translate(3px,3px);box-shadow:0 0 0 var(--ink)}
.back svg{width:18px;height:18px}
.room{width:min(1100px,100%);margin-inline:auto;display:grid;justify-items:center;gap:10px;text-align:center;padding-top:46px}
.room .title{font-size:clamp(2.4rem,7vw,4.2rem);animation:dropIn .9s .05s var(--pop) both}
.room .sub{animation:dropIn .9s .35s var(--pop) both}

/* ---------------- Gift 1: lilies ---------------- */
.lily-stage{position:relative;width:min(1000px,100%);display:grid;justify-items:center;margin-top:4px}
#lilyCanvas{display:block;width:min(540px,94vw);height:auto;aspect-ratio:1/1.12;cursor:default}
.tap-hint{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:-6px}
.qb{position:absolute;left:0;top:0;z-index:4;width:max-content;max-width:min(250px,70vw);padding:12px 16px 13px;border-radius:20px;background:var(--cream);border:2.5px solid var(--ink);
  box-shadow:4px 4px 0 var(--pink);text-align:left;pointer-events:none;will-change:transform,opacity}
.qb.alt{box-shadow:4px 4px 0 var(--blue)}
.qb .q{display:block;font-weight:800;font-size:1.05rem;line-height:1.3;text-wrap:pretty}
.qb .who{display:block;margin-top:4px;font-family:var(--f-mono);font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--pink)}
.qb.alt .who{color:#3c8fd0}
.poof{position:absolute;left:0;top:0;z-index:3;width:8px;height:8px;border-radius:50%;pointer-events:none}

/* ---------------- Gift 2: record ---------------- */
.deck-wrap{display:grid;justify-items:center;gap:22px;margin-top:14px;width:100%}
.tt{position:relative;width:min(620px,94vw);aspect-ratio:1.32/1;border-radius:28px;border:3px solid var(--ink);box-shadow:10px 10px 0 var(--ink);
  background:linear-gradient(160deg,#ffd6e3,#ffbcd1);animation:popIn .9s .3s var(--pop) both}
.tt::before{content:"";position:absolute;inset:12px;border-radius:20px;border:2px dashed rgba(43,53,102,.25);pointer-events:none}
.platter{position:absolute;left:5%;top:7%;height:86%;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);
  background:radial-gradient(circle,#e8eef6 0 60%,#c5d0de 61% 63%,#eef3f9 64% 100%);cursor:pointer}
.record{position:absolute;inset:3.2%;border-radius:50%;
  background:
    radial-gradient(circle,transparent 0 33%,rgba(255,255,255,.08) 33.5% 34%,transparent 34.5%),
    repeating-radial-gradient(circle,#121218 0 1.2px,#1e1e27 1.6px 2.6px,#131319 3px),#121218;
  box-shadow:inset 0 0 0 2px #2a2a35;animation:spin 1.8s linear infinite;animation-play-state:paused}
.playing .record{animation-play-state:running}
@keyframes spin{to{transform:rotate(360deg)}}
.label{position:absolute;inset:33.5%;border-radius:50%;background:radial-gradient(circle at 40% 35%,#e3f2fd,#9fd0f3 70%);overflow:hidden;box-shadow:0 0 0 2px var(--ink)}
.label svg{position:absolute;inset:0;width:100%;height:100%}
.hole{position:absolute;left:50%;top:50%;width:7%;aspect-ratio:1;border-radius:50%;transform:translate(-50%,-50%);background:#dfe6ef;box-shadow:0 0 0 2px var(--ink)}
.sheen{position:absolute;inset:3.2%;border-radius:50%;pointer-events:none;
  background:conic-gradient(from 20deg,transparent 0deg,rgba(255,255,255,.16) 22deg,transparent 48deg,transparent 180deg,rgba(255,255,255,.12) 205deg,transparent 232deg);
  -webkit-mask:radial-gradient(circle,transparent 34%,#000 35%);mask:radial-gradient(circle,transparent 34%,#000 35%)}
.arm{position:absolute;right:4%;top:5%;width:30%;height:82%;transform-origin:62% 13%;transform:rotate(0deg);transition:transform 1.2s var(--ease);pointer-events:none;z-index:2}
.tt-btn{position:absolute;right:5%;bottom:7%;width:16%;aspect-ratio:1;border-radius:50%;border:3px solid var(--ink);background:var(--blue);box-shadow:4px 4px 0 var(--ink);
  cursor:pointer;display:grid;place-items:center;transition:transform .1s,box-shadow .1s,background .3s;z-index:3}
.tt-btn:active{transform:translate(4px,4px);box-shadow:0 0 0 var(--ink)}
.playing .tt-btn{background:var(--pink)}
.tt-btn svg{width:42%;height:42%;fill:#fff;stroke:var(--ink);stroke-width:1.5}
.speed{position:absolute;right:23%;bottom:9%;display:flex;gap:4px;font-family:var(--f-mono);font-size:.7rem}
.speed span{border:2px solid var(--ink);border-radius:6px;padding:1px 6px;background:var(--cream)}
.speed span.on{background:var(--butter)}
.ticket{width:min(620px,94vw);display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:center;text-align:left;background:var(--cream);border:3px solid var(--ink);
  border-radius:20px;padding:16px 18px;box-shadow:6px 6px 0 var(--blue);animation:popIn .9s .55s var(--pop) both}
.mini{width:62px;aspect-ratio:1;border-radius:50%;background:repeating-radial-gradient(circle,#15151c 0 1px,#24242e 1.5px 2.5px);border:2.5px solid var(--ink);position:relative}
.mini::after{content:"";position:absolute;inset:32%;border-radius:50%;background:var(--pink);border:2px solid var(--ink)}
.trk{min-width:0}
.trk .tt1{font-family:var(--f-display);font-size:1.7rem;line-height:1;color:var(--pink)}
.trk .tt2{font-weight:800}
.trk .tt3{font-size:.85rem;color:var(--muted);font-weight:700}
.bar{grid-column:1/-1;display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;font-family:var(--f-mono);font-size:.78rem;font-variant-numeric:tabular-nums}
.bar .rail{height:10px;border-radius:999px;border:2px solid var(--ink);background:var(--blue-soft);overflow:hidden}
.bar .fill{display:block;height:100%;width:0;background:var(--pink)}
.tk-note{grid-column:1/-1;margin:0;font-size:.85rem;color:var(--muted);font-weight:700}
.tk-note a{color:#3c8fd0;font-weight:800}
.mnote{position:absolute;bottom:-50px;font-family:"Segoe UI Symbol","DejaVu Sans",var(--f-body);font-variant-emoji:text;pointer-events:none;
  text-shadow:2px 2px 0 #fff,-1px -1px 0 #fff;will-change:transform,opacity}
#mnotes{position:fixed;inset:0;z-index:6;pointer-events:none;overflow:hidden}

/* ---------------- Gift 3: bake ---------------- */
.bake{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr) minmax(0,1fr);gap:22px;align-items:start;width:100%;margin-top:18px;text-align:left}
.shelf{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.ing{display:grid;justify-items:center;gap:4px;padding:10px 6px 8px;border-radius:18px;border:2.5px solid var(--ink);background:var(--cream);box-shadow:4px 4px 0 var(--ink);
  cursor:pointer;font-weight:800;font-size:.9rem;transition:transform .12s,box-shadow .12s,opacity .3s;position:relative;-webkit-tap-highlight-color:transparent}
.ing:hover{transform:translateY(-3px) rotate(-2deg)}
.ing:active{transform:translate(4px,4px);box-shadow:0 0 0 var(--ink)}
.ing svg{width:58px;height:58px}
.ing.used{opacity:.45;cursor:default;transform:none;box-shadow:2px 2px 0 var(--ink)}
.ing.used::after{content:"✓";position:absolute;right:8px;top:4px;color:var(--pink);font-weight:900}
.bench{display:grid;justify-items:center;gap:14px}
.bowl-box{position:relative;width:100%;max-width:360px;aspect-ratio:1.25}
.bowl-box > svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
#whisk{transform-box:fill-box;transform-origin:50% 90%;opacity:0;transition:opacity .3s}
.mixing #whisk{opacity:1;animation:whisk .35s ease-in-out infinite alternate}
@keyframes whisk{from{transform:rotate(-16deg) translateX(-10px)}to{transform:rotate(16deg) translateX(10px)}}
.mixing #swirl{animation:swirl 1s linear infinite}
#swirl{transform-box:fill-box;transform-origin:center}
@keyframes swirl{to{transform:rotate(360deg)}}
.oven-mini,.cake-out{position:absolute;inset:0;display:grid;place-items:center}
.oven-mini svg{width:88%;height:auto;overflow:visible}
.cake-out svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.cake-out svg{animation:cakeUp .9s var(--pop) both}
@keyframes cakeUp{from{transform:translateY(40px) scale(.5);opacity:0}to{transform:none;opacity:1}}
.flame{transform-box:fill-box;transform-origin:50% 100%;animation:flick .5s ease-in-out infinite alternate}
@keyframes flick{from{transform:scale(1,1) rotate(-3deg)}to{transform:scale(.88,1.1) rotate(3deg)}}
.big-btn{border:3px solid var(--ink);border-radius:999px;background:var(--pink);color:#fff;font-family:var(--f-display);font-size:1.3rem;padding:10px 26px;
  box-shadow:5px 5px 0 var(--ink);cursor:pointer;transition:transform .1s,box-shadow .1s}
.big-btn:active{transform:translate(5px,5px);box-shadow:0 0 0 var(--ink)}
.big-btn:disabled{background:#efe3ec;color:#a497b5;cursor:not-allowed;box-shadow:3px 3px 0 #a497b5;border-color:#a497b5}
.bench-msg{margin:0;font-weight:800;text-align:center;min-height:1.5em;max-width:42ch;text-wrap:pretty}
.recipe{position:relative;background:#fff;border:2.5px solid var(--ink);border-radius:8px;padding:18px 18px 18px 46px;box-shadow:5px 5px 0 var(--pink);transform:rotate(1.2deg);
  background-image:linear-gradient(90deg,transparent 34px,rgba(255,111,156,.5) 34px 36px,transparent 36px),repeating-linear-gradient(transparent 0 29px,rgba(127,194,240,.45) 29px 30px);
  background-position:0 0,0 14px}
.recipe h3{margin:0 0 6px;font-family:var(--f-display);font-weight:400;font-size:1.5rem;color:var(--pink);line-height:1.1}
.recipe .serves{font-family:var(--f-mono);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.recipe ol{margin:8px 0 0;padding-left:18px;font-weight:700;font-size:.95rem;line-height:30px}
.recipe li{animation:popIn .5s var(--pop) both}
.recipe .empty{color:var(--muted);font-weight:600;list-style:none;margin-left:-18px}
.confetti{position:fixed;z-index:7;width:6px;height:16px;border-radius:4px;pointer-events:none}

/* ---------------- responsive ---------------- */
@media (max-width:960px){
  .bake{grid-template-columns:1fr;max-width:520px}
  .bench{order:-1}
  .shelf{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (max-width:700px){
