      ctx.strokeStyle = "#4f7f45"; ctx.lineWidth = W * (f.kind.startsWith("bud") ? .009 : .012); ctx.stroke();
      ctx.strokeStyle = "rgba(170,210,140,.55)"; ctx.lineWidth = W * .003; ctx.stroke();
      for (const [t, side] of [[.42, 1], [.56, -1], [.7, 1]]) {
        if (f.kind.startsWith("bud") && t > .6) continue;
        const p = qbez(a, c, b, t), p2 = qbez(a, c, b, t + .02);
        const tan = Math.atan2(p2[1] - p[1], p2[0] - p[0]);
        leaf(p[0], p[1], tan + side * (.55 + (i % 3) * .08), W * (.11 + (i % 2) * .02), W * .016);
      }
    });
    [...FLOWERS].sort((a, b) => a.y - b.y).forEach(f => {
      if (f.dirty) paintSprite(f);
      ctx.save(); ctx.translate(f.px, f.py); ctx.rotate(f.ang); ctx.drawImage(f.sprite, -f.sprite.width / 2, -f.sprite.height / 2); ctx.restore();
    });
    gr = ctx.createLinearGradient(W * .12, 0, W * .88, 0);
    [[0, "#f59fbd"], [.18, "#ffd3e1"], [.36, "#f7aac4"], [.55, "#ffd8e5"], [.75, "#f5a3bf"], [1, "#ffc9da"]].forEach(([o, c]) => gr.addColorStop(o, c));
    ctx.beginPath(); ctx.moveTo(W * .1, H * .66); ctx.quadraticCurveTo(W * .3, H * .6, W * .5, H * .7); ctx.quadraticCurveTo(W * .7, H * .6, W * .9, H * .66);
    ctx.lineTo(W * .6, H * .995); ctx.quadraticCurveTo(W * .5, H * 1.0, W * .4, H * .995); ctx.closePath();
    ctx.fillStyle = gr; ctx.fill(); ctx.strokeStyle = "#2b3566"; ctx.lineWidth = W * .005; ctx.stroke();
    ctx.strokeStyle = "rgba(200,90,130,.25)"; ctx.lineWidth = W * .003;
    for (const [x1, x2] of [[.25, .45], [.5, .5], [.72, .55]]) { ctx.beginPath(); ctx.moveTo(W * x1, H * .66); ctx.lineTo(W * x2, H * .98); ctx.stroke(); }
    const bx = W * .5, by = H * .84;
    gr = ctx.createLinearGradient(0, by - W * .05, 0, by + W * .05); gr.addColorStop(0, "#bfe2fa"); gr.addColorStop(.5, "#7fc2f0"); gr.addColorStop(1, "#5aa7de");
    ctx.fillStyle = gr; ctx.strokeStyle = "#2b3566"; ctx.lineWidth = W * .004;
    ctx.beginPath(); ctx.moveTo(W * .345, by - W * .018); ctx.quadraticCurveTo(bx, by + W * .01, W * .655, by - W * .018); ctx.lineTo(W * .645, by + W * .02); ctx.quadraticCurveTo(bx, by + W * .05, W * .355, by + W * .02); ctx.closePath(); ctx.fill(); ctx.stroke();
    const loop = s => { ctx.beginPath(); ctx.moveTo(bx, by); ctx.bezierCurveTo(bx + s * W * .05, by - W * .09, bx + s * W * .14, by - W * .03, bx + s * W * .1, by + W * .015); ctx.bezierCurveTo(bx + s * W * .07, by + W * .04, bx + s * W * .03, by + W * .015, bx, by); ctx.fill(); ctx.stroke(); };
    const tail = s => { ctx.beginPath(); ctx.moveTo(bx, by); ctx.quadraticCurveTo(bx + s * W * .03, by + W * .07, bx + s * W * .07, by + W * .12); ctx.lineTo(bx + s * W * .035, by + W * .115); ctx.quadraticCurveTo(bx + s * W * .01, by + W * .06, bx - s * W * .01, by + W * .01); ctx.fill(); ctx.stroke(); };
    tail(-1); tail(1); loop(-1); loop(1);
    ctx.beginPath(); ctx.ellipse(bx, by + W * .004, W * .022, W * .018, 0, 0, 6.283); ctx.fill(); ctx.stroke();
  }
  function frame(now) {
    if (!t0) t0 = now;
    const el = now - t0;
    for (const f of FLOWERS) {
      if (f.kind.startsWith("bud")) continue;
      const p = REDUCE ? 1 : Math.min(1, Math.max(0, (el - f.delay) / 1900));
      const o = 1 - Math.pow(1 - p, 3);
      if (Math.abs(o - f.open) > .004) { f.open = o; f.dirty = true; }
    }
    draw(now);
    raf = requestAnimationFrame(frame);
  }

  function popQuote(fi) {
    const blooms = FLOWERS.filter(f => !f.kind.startsWith("bud"));
    const f = fi != null ? FLOWERS[fi] : pick(blooms);
    const existing = stage.querySelectorAll(".qb");
    if (existing.length >= 4) existing[0].remove();
    let qi; do { qi = Math.floor(Math.random() * CONFIG.quotes.length); } while (qi === lastQ && CONFIG.quotes.length > 1); lastQ = qi;
    const Q = CONFIG.quotes[qi];
    const sx = cv.offsetLeft + f.px / dpr, sy = cv.offsetTop + f.py / dpr;
    for (let k = 0; k < 8; k++) {
      const d = document.createElement("span"); d.className = "poof";
      d.style.cssText = `background:${pick(["#ff6f9c", "#7fc2f0", "#ffe08a", "#ffffff"])};border:1.5px solid #2b3566`;
      stage.appendChild(d);
      const an = rand(0, 6.28), dist = rand(26, 60);
      d.animate([{ transform: `translate(${sx - 4}px,${sy - 4}px) scale(1)`, opacity: 1 }, { transform: `translate(${sx - 4 + Math.cos(an) * dist}px,${sy - 4 + Math.sin(an) * dist}px) scale(.3)`, opacity: 0 }], { duration: 700, easing: "ease-out", fill: "both" }).onfinish = () => d.remove();
    }
